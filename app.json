{
  "expo": {
    "name": "medsync",
    "slug": "medsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/medSyncLogo.jpg",
    "scheme": "medsync1",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/medSyncLogo.jpg",
        "backgroundImage": "./assets/images/medSyncLogo.jpg",
        "monochromeImage": "./assets/images/medSyncLogo.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lazykaleidoscopesteam.medsync"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/medSyncLogo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "611e99b2-5360-4700-8d1b-b691c157fc7f"
      }
    },
    "owner": "lazykaleidoscopes-team"
  }
}
